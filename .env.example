# GSS Pipeline Environment Configuration
# Copy to .env and adjust values

# GPU settings
CUDA_VISIBLE_DEVICES=0

# Data paths
GSS_DATA_ROOT=./data
GSS_CONFIG_PATH=./configs/pipeline.yaml

# External tools
COLMAP_PATH=colmap

# Logging
GSS_LOG_LEVEL=INFO

# Step overrides (optional)
# GSS_S01_TARGET_FPS=2.0
# GSS_S03_ITERATIONS=30000
# GSS_S05_VOXEL_SIZE=0.006

# --- Server (FastAPI) ---
GSS_JOBS_DIR=./data/jobs
GSS_DEFAULT_PIPELINE_CONFIG=./configs/pipeline_import.yaml
GSS_UPLOAD_MAX_BYTES=2147483648
GSS_WORKER_COUNT=1
GSS_HOST=0.0.0.0
GSS_PORT=8000

# --- Nucleus (Phase 3) ---
# GSS_NUCLEUS_SERVER=omniverse://192.168.1.100
# GSS_NUCLEUS_PROJECT_PATH=/Projects/GSS

# --- MQTT (Phase 4) ---
# GSS_MQTT_BROKER_HOST=localhost
# GSS_MQTT_BROKER_PORT=1883
# GSS_MQTT_TOPICS=gss/sensors/#
